extends RefCounted
# Original generated fictional eclipse mask. No external model or museum image copied.
# Embedded PNG is the exact recovery source; no runtime network or extra viewport.
const PNG = ""
static var cached: ImageTexture
static func texture() -> ImageTexture:
 if cached == null:
  var image = Image.new()
  var error = image.load_png_from_buffer(Marshalls.base64_to_raw(PNG))
  if error != OK:
   push_error("Eclipse mask PNG decode failed")
   return null
  cached = ImageTexture.create_from_image(image)
 return cached
static func add_face(guardian: MeshInstance3D):
 var face = Sprite3D.new()
 face.name = "EclipseMask"
 face.texture = texture()
 face.pixel_size = 1.8 / 256.0
 face.position.z = 0.94
 face.shaded = false
 face.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
 face.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
 face.alpha_scissor_threshold = 0.3
 guardian.add_child(face)
static func state(guardian: MeshInstance3D, opened: bool, exhausted: bool):
 guardian.get_node("EclipseMask").modulate = Color("c0a3ce") if not opened else Color("b1edda") if not exhausted else Color("edd099")
