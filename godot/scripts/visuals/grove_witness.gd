extends RefCounted
# Original illustrated Wu Gang, derived only from the game's original reunion card.
# Exact recovery PNG; no third-party character model or runtime network.
const PNG = ""
static var cached: ImageTexture
static func texture() -> ImageTexture:
 if cached == null:
  var image=Image.new()
  var error=image.load_png_from_buffer(Marshalls.base64_to_raw(PNG))
  if error != OK:
   push_error("Grove witness PNG decode failed")
   return null
  cached=ImageTexture.create_from_image(image)
 return cached
static func add_witness(actor: Node3D):
 var witness=Sprite3D.new()
 witness.name="WuGangWitness"
 witness.texture=texture()
 witness.pixel_size=2.0 / 562.0
 witness.position=Vector3(0.95,1.0,0.0)
 witness.shaded=false
 witness.texture_filter=BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
 witness.alpha_cut=SpriteBase3D.ALPHA_CUT_DISCARD
 witness.alpha_scissor_threshold=0.3
    actor.add_child(witness)
