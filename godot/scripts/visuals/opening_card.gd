extends TextureRect
# Original opening illustration, derived from the game's original reunion art.
# Static menu-only texture. No gameplay, input or persistence state.
func _init():
 mouse_filter=Control.MOUSE_FILTER_IGNORE
 expand_mode=TextureRect.EXPAND_IGNORE_SIZE
 stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_CENTERED
 var image=Image.new()
 if image.load_webp_from_buffer(Marshalls.base64_to_raw(ART_DATA))!=OK:
  push_error("Opening illustration could not decode")
  return
 texture=ImageTexture.create_from_image(image)
 hide()
func arrange(game):
 if not visible:return
 var d=get_viewport().get_visible_rect().size
 if d.x>d.y:
  position=Vector2(24,d.y*.16);size=Vector2(minf(d.x*.53,d.x-414),d.y*.72)
  game.message.position=Vector2(d.x-374,20 if d.y<650 else 110)
  game.message.size=Vector2(354,120 if d.y<650 else 170)
  game.panel.position=Vector2(d.x-367,155 if d.y<650 else 300)
 else:
  game.message.position=Vector2((d.x-354)/2,22);game.message.size=Vector2(354,110)
  var art_top=maxf(136,game.message.position.y+game.message.size.y+8)
  position=Vector2(24,art_top);size=Vector2(d.x-48,maxf(0,350-art_top))
const ART_DATA=""
