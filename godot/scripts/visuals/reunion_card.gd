extends Control
# Original still-life art, baked once: no added active viewport or 3D work.
const ART_DATA = ""
var title:Label
var words:Label
var picture:TextureRect
var actions:VBoxContainer
var primary:Button
var menu:Button
var settings:Button
var game:Node
func _init(owner_game:Node):
 game=owner_game
 mouse_filter=Control.MOUSE_FILTER_STOP
 set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
 var bg=ColorRect.new();bg.color=Color("101d1a");bg.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT);bg.mouse_filter=Control.MOUSE_FILTER_IGNORE;add_child(bg)
 picture=TextureRect.new();picture.mouse_filter=Control.MOUSE_FILTER_IGNORE
 var image=Image.new();var image_error=image.load_png_from_buffer(Marshalls.base64_to_raw(ART_DATA))
 if image_error!=OK: push_error("Reunion artwork could not decode")
 picture.texture=ImageTexture.create_from_image(image);picture.expand_mode=TextureRect.EXPAND_IGNORE_SIZE;picture.stretch_mode=TextureRect.STRETCH_KEEP_ASPECT_CENTERED;add_child(picture)
 title=Label.new();title.text="The Mooncake of Reunion";title.horizontal_alignment=HORIZONTAL_ALIGNMENT_CENTER;title.add_theme_color_override("font_color",NeonHudTheme.ACCENT_TEXT);add_child(title)
 words=Label.new();words.text="Chang'e: You came all this way. Sit. Share this mooncake with me. Wu Gang joins them beneath the cinnamon tree.";words.horizontal_alignment=HORIZONTAL_ALIGNMENT_CENTER;words.autowrap_mode=TextServer.AUTOWRAP_WORD_SMART;words.add_theme_color_override("font_color",NeonHudTheme.TEXT_MAIN);add_child(words)
 actions=VBoxContainer.new();actions.add_theme_constant_override("separation",8);add_child(actions)
 primary=Button.new();primary.text="NEW JOURNEY";primary.custom_minimum_size.y=56;primary.pressed.connect(func():game.on_action());actions.add_child(primary)
 menu=Button.new();menu.text="MAIN MENU";menu.custom_minimum_size.y=44;menu.pressed.connect(func():game.return_menu());actions.add_child(menu)
 settings=Button.new();settings.text="SETTINGS";settings.custom_minimum_size.y=44;settings.pressed.connect(func():game.open_settings());actions.add_child(settings)
 NeonHudTheme.apply(actions,{"primary":primary})
func arrange():
 var dims=get_viewport().get_visible_rect().size
 var landscape=dims.x>dims.y*1.3
 var margin=24.0
 title.position=Vector2(margin,dims.y*.045);title.size=Vector2(dims.x-2*margin,40);title.add_theme_font_size_override("font_size",22)
 if landscape:
  picture.position=Vector2(dims.x*.02,dims.y*.19);picture.size=Vector2(dims.x*.49,dims.y*.70)
  words.position=Vector2(dims.x*.54,dims.y*.19);words.size=Vector2(dims.x*.42,dims.y*.30)
  actions.position=Vector2(dims.x*.56,dims.y*.53);actions.size=Vector2(dims.x*.38,0)
 else:
  picture.position=Vector2(margin,dims.y*.14);picture.size=Vector2(dims.x-2*margin,dims.y*.33)
  words.position=Vector2(margin,dims.y*.48);words.size=Vector2(dims.x-2*margin,dims.y*.20)
  actions.position=Vector2(margin,dims.y*.72);actions.size=Vector2(dims.x-2*margin,0)
 words.add_theme_font_size_override("font_size",18 if game.options.large else 16)
