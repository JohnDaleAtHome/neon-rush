extends RefCounted
# Original illustrated kindness tableau, using only original game art as reference.
# A static Sprite3D in the stopped Shadow Comet encounter, not a running actor.
const PNG = ""
static var cached: ImageTexture
static func texture() -> ImageTexture:
 if cached == null:
  var image=Image.new()
  var error=image.load_png_from_buffer(Marshalls.base64_to_raw(PNG))
  if error != OK:
   push_error("Shadow kindness illustration decode failed")
   return null
  cached=ImageTexture.create_from_image(image)
 return cached
static func add_offer(actor: Node3D):
 var picture=Sprite3D.new()
 picture.name="ShadowKindnessOffer"
 picture.texture=texture()
 picture.pixel_size=2.65 / float(picture.texture.get_height())
 picture.position=Vector3(0,1.25,0)
 picture.shaded=false
 picture.texture_filter=BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
 picture.alpha_cut=SpriteBase3D.ALPHA_CUT_DISCARD
 picture.alpha_scissor_threshold=0.3
 actor.add_child(picture)
static func arrange(actor: Node3D, size: Vector2):
 var picture=actor.get_node_or_null("ShadowKindnessOffer") as Sprite3D
 if picture==null:return
 var compact=size.x/size.y>1.4 and size.y<600
 picture.scale=Vector3.ONE*(1.45 if compact else 1.0)
 picture.position=Vector3(0,.55 if compact else 1.25,0)
